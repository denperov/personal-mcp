{
  "name": "personal-mcp-garmin",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  // an empty list removes crons left over from earlier deploys; without the triggers key they would stay
  "triggers": { "crons": [] },
  "durable_objects": { "bindings": [{ "name": "USER_DO", "class_name": "UserStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserStore"] }],
  "vars": {
    "STEP_GAP_MS": "500"
  },
  "secrets": { "required": ["KEY_ENCRYPTION_KEY"] },
  "observability": { "enabled": true }
}
